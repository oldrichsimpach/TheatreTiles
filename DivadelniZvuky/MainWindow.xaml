<Window x:Class="DivadelniZvuky.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TheatreTiles · 0.2.3" Icon="Assets/TheatreTiles.ico" Width="1280" Height="850" MinWidth="720" MinHeight="560" Foreground="#F4F4F5" FontFamily="Segoe UI" AllowDrop="True">

 <Window.Resources>
  <Style x:Key="CueNoteToolTip" TargetType="ToolTip">
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ToolTip">
      <Border Background="#303034" CornerRadius="12" Padding="14,10">
       <ContentPresenter/>
      </Border>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel>
   <Button x:Name="FullscreenButton" DockPanel.Dock="Right" Width="46" Height="46" Padding="10" ToolTip="Celá obrazovka (F11)" Click="FullscreenClick" Background="#20242F">
    <Path x:Name="FullscreenGlyph" Stroke="#F4F4F5" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="22" Height="22" Data="M8,2 L2,2 2,8 M2,2 L9,9 M16,2 L22,2 22,8 M22,2 L15,9 M2,16 L2,22 8,22 M2,22 L9,15 M22,16 L22,22 16,22 M22,22 L15,15"/>
   </Button>
   <Button x:Name="LayoutLockButton" DockPanel.Dock="Right" Width="46" Height="46" Margin="0,0,10,0" Padding="11" ToolTip="Uzamknout rozložení" Click="LayoutLockClick" Background="#20242F">
    <Path x:Name="LayoutLockGlyph" Stroke="#F4F4F5" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="22" Height="22" Data="M7,11 L7,7 A5,5 0 0 1 17,7 M5,11 L19,11 19,22 5,22 Z M12,15 L12,18"/>
   </Button>
   <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
    <Button Content="▣  Uložit projekt" Click="SaveClick" Margin="0,0,10,0"/>
    <Button Content="Otevřít" Click="OpenClick" Margin="0,0,10,0"/>
    <Button Content="Nový" Click="NewClick"/>
   </StackPanel>
   <TextBlock x:Name="ProjectLabel" Text="Nové představení" VerticalAlignment="Center" Margin="24,0,0,0" FontSize="18" Foreground="#A1A1AA"/>
  </DockPanel>
  <Grid Grid.Row="1" Margin="0,28,0,24" x:Name="StageHost" SizeChanged="HostSizeChanged">
   <Canvas x:Name="SectionCanvas" Background="Transparent" ClipToBounds="True"/>
  </Grid>
  <Grid Grid.Row="2" MinHeight="46">
  <StackPanel x:Name="Transport" Visibility="Collapsed">
   <TextBlock x:Name="NowPlaying" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,10"/>
   <DockPanel>
    <TextBlock x:Name="PositionText" Text="00:00" FontSize="16" VerticalAlignment="Center" Width="65"/>
    <TextBlock x:Name="DurationText" Text="00:00" DockPanel.Dock="Right" FontSize="16" VerticalAlignment="Center" Width="65" TextAlignment="Right"/>
    <Slider x:Name="Seek" Minimum="0" Maximum="1" ValueChanged="SeekChanged" VerticalAlignment="Center" Height="40" Background="Transparent" IsMoveToPointEnabled="True" ToolTip="Kliknutím přeskočit na čas">
     <Slider.Template><ControlTemplate TargetType="Slider">
      <Grid Background="Transparent">
       <Border Height="4" CornerRadius="2" Background="#626575" VerticalAlignment="Center" Margin="7,0"/>
       <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" Orientation="Horizontal">
        <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge"><RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
        <Track.Thumb><Thumb Width="16" Height="16" VerticalAlignment="Center"><Thumb.Template><ControlTemplate><Border Background="#F4F4F5" CornerRadius="8"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge"><RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
       </Track>
      </Grid>
     </ControlTemplate></Slider.Template>
    </Slider>
   </DockPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
    <Button Content="↶ 5 s" Click="BackClick" Margin="6,0"/>
    <Button x:Name="PlayButton" Content="Ⅱ" Click="PlayClick" Width="70" FontSize="24" Margin="6,0"/>
    <Button Content="■" Click="StopClick" Width="60" Margin="6,0"/>
    <Button Content="5 s ↷" Click="ForwardClick" Margin="6,0"/>
   </StackPanel>
  </StackPanel>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,9">
   <Button x:Name="MasterMute" ToolTip="Ztlumit zvuk" Click="MuteClick" Padding="3" BorderThickness="0" Background="Transparent" Width="34" Height="34">
    <Viewbox Width="26" Height="26">
     <Canvas Width="28" Height="28">
      <Path Fill="#F4F4F5" Data="M3,10 Q2,10 2,11 L2,17 Q2,18 3,18 L7,18 L13,23 Q14,24 14,22 L14,6 Q14,4 13,5 L7,10 Z"/>
      <Path x:Name="VolumeWaves" Stroke="#F4F4F5" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M18,10 C21,12 21,16 18,18 M22,6 C28,10 28,18 22,22"/>
      <Path x:Name="VolumeCross" Visibility="Collapsed" Stroke="#F4F4F5" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M19,10 L26,18 M26,10 L19,18"/>
     </Canvas>
    </Viewbox>
   </Button>
   <Slider x:Name="MasterVolume" Minimum="0" Maximum="1" Value="1" Width="84" SmallChange="0.01" LargeChange="0.1" VerticalAlignment="Center" ValueChanged="MasterVolumeChanged" ToolTip="Hlavní hlasitost"/>
   <TextBlock x:Name="MasterPercent" Text="100 %" FontSize="12" Width="39" TextAlignment="Right" VerticalAlignment="Center"/>
  </StackPanel>
  </Grid>
 </Grid>
</Window>
